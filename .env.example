# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_SITE_URL: Your live custom domain (e.g. https://yourdomain.com).
# Used for canonical tags, OpenGraph URLs, robots.txt, and sitemap.xml when deployed with a custom domain.
PUBLIC_SITE_URL=""

# DATA_DIR: Optional persistent volume path for database storage (e.g. /data in Docker/Cloud Run/Railway).
# Defaults to ./server/data when unset.
DATA_DIR=""

# GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=""

# SESSION_SECRET: Cryptographic secret (32+ chars) for signing HTTP-only session cookies in production.
# Required in production so sessions survive restarts and multi-worker deployments.
SESSION_SECRET=""

# ADMIN_EMAIL / ADMIN_PASSWORD: Administrator bootstrap credentials for the Governance Console.
# Never expose these in frontend client code.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Transactional Email Delivery (configure EITHER Resend OR SMTP for password resets, price alerts & contact tickets)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PriceAlerter <no-reply@pricealerter.in>"
# Cloudflare Pages password-reset links should use the production origin.
SITE_URL="https://pricealerter.in"
CONTACT_NOTIFY_EMAIL=""

# Optional Webhook URL (Slack / Discord / custom endpoint) for real-time triggered alerts & contact tickets
ALERT_WEBHOOK_URL=""

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456).
# Leave blank until your domain is approved and verified for AdSense serving.
ADSENSE_PUBLISHER_ID=""
VITE_ADSENSE_CLIENT_ID=""

# Alpha Vantage Financial Intelligence API Key (quotes, macroeconomic indicators, spot commodities, and company logos)
ALPHA_VANTAGE_API_KEY=""

# INDstocks API Suite (OHLCV time-series historical data and expired F&O contract candles)
INDSTOCKS_ACCESS_TOKEN=""
INDSTOCKS_API_BASE_URL="https://api.indstocks.com"

# Optional: Set only if hosting static frontend on Cloudflare Pages separately from the Node API server.
VITE_API_BASE_URL=""
CORS_ALLOWED_ORIGINS=""
