# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_SITE_URL: Your live custom domain (e.g. https://yourdomain.com).
# Used for canonical tags, OpenGraph URLs, robots.txt, and sitemap.xml when deployed with a custom domain.
PUBLIC_SITE_URL=""

# GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=""

# SESSION_SECRET: Cryptographic secret for signing HTTP-only session cookies in production.
SESSION_SECRET=""

# ADMIN_EMAIL / ADMIN_PASSWORD: Administrator bootstrap credentials for the Governance Console.
# Never expose these in frontend client code.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456).
# Leave blank until your domain is approved and verified for AdSense serving.
ADSENSE_PUBLISHER_ID=""
VITE_ADSENSE_CLIENT_ID=""

# Optional: Set only if hosting static frontend on Cloudflare Pages separately from the Node API server.
VITE_API_BASE_URL=""
CORS_ALLOWED_ORIGINS=""



